# PearNotes environment template — names only, never real values.
# Copy to `.env.local` for local dev. `.env.local` is gitignored; do not commit it.
#
# Values come from the PearNotes Convex deployment (separate dev/preview/prod),
# provisioned by the project owner — see docs/phase00/DEPLOYMENT.md.
# NEVER point these at the upstream OurSpaces deployments
# (necessary-cobra-892, dusty-condor-648).

# --- Client (Vite, bundled into the build; public by design) ---

# Convex cloud URL of the PearNotes deployment, e.g. https://<name>.convex.cloud
VITE_CONVEX_URL=

# Convex site URL of the same deployment, e.g. https://<name>.convex.site
VITE_CONVEX_SITE_URL=

# Optional: force the no-backend visual prototype ("mock"), used by `?mock=1`.
# VITE_DATA_MODE=mock

# Optional feature flags.
# VITE_DEMO=
# VITE_PEARNOTES=1

# --- Convex CLI (local dev only; identifies which deployment `convex dev` targets) ---

# e.g. dev:<deployment-name>. Set by `npx convex dev` on first run.
CONVEX_DEPLOYMENT=

# --- Deployment env vars (server side) ---
# These are NOT client vars and are NOT read from .env.local. They are set on
# the Convex deployment itself: `npx convex env set NAME value`. Listed here
# only so required names are documented — convex/convex.config.ts validates
# FIRECRAWL_API_KEY and AGENTMAIL_API_KEY at push time.
#
#   NEBIUS_API_KEY           Nemotron calls (convex/nebius.ts); absent → canned AI
#   FIRECRAWL_API_KEY        required by convex.config.ts
#   FIRECRAWL_WEBHOOK_SECRET optional
#   AGENTMAIL_API_KEY        required by convex.config.ts
#   TAVILY_API_KEY           optional; place lookups
#
# Phase 00.5+ will add the Meta-model provider credential — name TBD, do not
# invent one here.
